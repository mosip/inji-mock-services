{
  "fields": {
    "id": {
      "type": "integer"
    },
    "companyName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 255
    },
    "registrationStatus": {
      "type": "string",
      "regex": "^(Active|Inactive)$"
    },
    "registrationType": {
      "type": "string",
      "maxLength": 100
    },
    "registeredEmail": {
      "type": "string",
      "regex": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,}$"
    }
  },
  "required": [
    "companyName",
    "registrationStatus",
    "registrationType",
    "registeredEmail"
  ]
}
